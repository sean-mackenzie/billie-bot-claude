<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>billiebot_sensor_tests</name>
  <version>0.1.0</version>
  <description>Bench-test suite for BillieBot sensors (OAK-D Lite, MLX90640, Pi Camera 3 NoIR, reSpeaker XVF3800, and the Sensor Nano platform-sensor unit carrying a DFRobot SEN0253 BNO055/BMP280 plus the battery-sense divider), independent of chassis/nav bringup and of billiebot_tests' mock-stack integration checks. The Sensor Nano battery tests are the one exception to "independent of mission": UT-BAT-02/02B deliberately drive the real billiebot_mission controller, because the shipping SAFE logic is what is under test.</description>
  <maintainer email="billie@todo.todo">billie</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>billiebot_interfaces</depend>
  <depend>billiebot_audio</depend>

  <!-- JPEG/PNG encoding for the low-bandwidth Foxglove preview topics (common/preview.py).
       Already present on both hosts as a transitive matplotlib dependency; declared here
       because the bench preview path depends on it directly. -->
  <exec_depend>python3-pil</exec_depend>

  <!-- Sensor Nano serial link (sensor_nano/sensor_nano_bridge.py and the sensor_nano
       preflight both open the port with pyserial). -->
  <exec_depend>python3-serial</exec_depend>

  <!-- UT-BAT-01 is the first test in this package to write plots/ PNGs
       (sensor_nano/analyze_battery.py). The import is guarded so a host without matplotlib
       still produces a valid verdict, but the dependency is now real rather than assumed. -->
  <exec_depend>python3-matplotlib</exec_depend>

  <!-- UT-IMU-02 runs robot_localization's ekf_node against a bench-only YAML, and publishes
       the bench base_link->imu_link transform with tf2_ros. -->
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>

  <!-- UT-BAT-02/02B launch the REAL production mission controller rather than a mock. -->
  <exec_depend>billiebot_mission</exec_depend>

  <exec_depend>billiebot_perception</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>rosbag2</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
