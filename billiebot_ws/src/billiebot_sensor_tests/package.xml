<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>billiebot_sensor_tests</name>
  <version>0.1.0</version>
  <description>Bench-test suite for BillieBot sensors (OAK-D Lite, MLX90640, Pi Camera 3 NoIR, reSpeaker XVF3800), independent of chassis/nav/mission bringup and of billiebot_tests' mock-stack integration checks</description>
  <maintainer email="billie@todo.todo">billie</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>billiebot_interfaces</depend>
  <depend>billiebot_audio</depend>

  <exec_depend>billiebot_perception</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>rosbag2</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
