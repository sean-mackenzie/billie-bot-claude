      "floatingLegendPosition": "top-left",
      "showPlotValuesInLegend": true,
      "showYAxisGridLines": true,
      "isSynced": true
    },
    "StateTransitions!bat01_band": {
      "foxglovePanelTitle": "Voltage band vs 10.5 V / 9.9 V",
      "paths": [
        {
          "value": "/battery_state.voltage",
          "enabled": true,
          "label": "pack voltage",
          "timestampMethod": "receiveTime",
          "customStates": {
            "type": "range",
            "states": [
              {
                "operator": "<",
                "value": 9.9,
                "label": "< 9.9 V critical",
                "color": "#7f0000"
              },
              {
                "operator": "<",
                "value": 10.5,
                "label": "< 10.5 V",
                "color": "#d62728"
              }
            ],
            "otherwise": {
              "label": ">= 10.5 V",
              "color": "#2ca02c"
            }
          }
        }
      ],
      "isSynced": true,
      "timeWindowMode": "sliding",
      "xAxisRange": 120,
      "showPoints": false
    },
