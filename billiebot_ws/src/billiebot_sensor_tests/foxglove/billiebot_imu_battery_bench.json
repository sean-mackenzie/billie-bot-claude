    "Plot!imu01_gyro": {
      "foxglovePanelTitle": "Gyro X/Y/Z (rad/s) - stationary should sit inside +/-0.10",
      "paths": [
        {
          "value": "/imu/data.angular_velocity.x",
          "enabled": true,
          "label": "gyro_x",
          "color": "#1f77b4",
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/imu/data.angular_velocity.y",
          "enabled": true,
          "label": "gyro_y",
          "color": "#ff7f0e",
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/imu/data.angular_velocity.z",
          "enabled": true,
          "label": "gyro_z",
          "color": "#2ca02c",
          "timestampMethod": "receiveTime"
        }
      ],
      "xAxisVal": "timestamp",
      "timeWindowMode": "sliding",
      "followingViewWidth": 30,
      "yAxisLabel": "angular velocity (rad/s)",
      "showLegend": true,
      "legendDisplay": "floating",
      "floatingLegendPosition": "top-left",
      "showPlotValuesInLegend": true,
      "showYAxisGridLines": true,
      "isSynced": true
    },
    "Plot!imu01_accel": {
