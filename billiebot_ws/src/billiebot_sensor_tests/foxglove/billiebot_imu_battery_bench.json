    "Plot!bat01_voltage": {
      "foxglovePanelTitle": "Pack voltage (V) with the 10.5 V SAFE threshold",
      "paths": [
        {
          "value": "/battery_state.voltage",
          "enabled": true,
          "label": "battery_state.voltage",
          "color": "#1f77b4",
          "lineSize": 2,
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/battery_state.voltage.@mul(0).@add(10.5)",
          "enabled": true,
          "label": "SAFE threshold 10.5 V",
          "color": "#d62728",
          "lineSize": 1,
          "lineStyle": "dashed",
          "timestampMethod": "receiveTime"
        },
        {
          "value": "/battery_state.voltage.@mul(0).@add(9.9)",
          "enabled": true,
          "label": "critical 9.9 V",
          "color": "#7f0000",
          "lineSize": 1,
          "lineStyle": "dotted",
          "timestampMethod": "receiveTime"
        }
      ],
      "xAxisVal": "timestamp",
      "timeWindowMode": "sliding",
      "followingViewWidth": 120,
      "minYValue": 9.5,
      "maxYValue": 13,
      "yAxisLabel": "pack voltage (V)",
      "showLegend": true,
      "legendDisplay": "floating",
      "floatingLegendPosition": "top-left",
      "showPlotValuesInLegend": true,
      "showYAxisGridLines": true,
      "isSynced": true
    },
    "Gauge!bat01_gauge": {
      "foxglovePanelTitle": "Pack voltage",
      "path": "/battery_state.voltage",
      "style": "dial",
      "minValue": 9.5,
      "maxValue": 13,
      "tickInterval": 0.5,
      "showTicks": true,
      "colorMode": "colormap",
      "colorMap": "red-yellow-green",
      "reverse": false,
      "reverseDirection": false
    },
    "Indicator!bat01_threshold": {
      "foxglovePanelTitle": "Voltage vs SAFE threshold",
      "path": "/battery_state.voltage",
      "style": "background",
      "fontSize": 20,
      "rules": [
        {
          "operator": "<",
          "rawValue": "9.9",
          "color": "#7f0000",
          "label": "< 9.9 V CRITICAL"
        },
        {
          "operator": "<",
          "rawValue": "10.5",
          "color": "#d62728",
          "label": "< 10.5 V SAFE THRESHOLD"
        }
      ],
      "fallbackColor": "#2ca02c",
      "fallbackLabel": ">= 10.5 V"
    },
    "Plot!bat01_adc": {
      "foxglovePanelTitle": "Raw Arduino ADC mean (counts, full scale 0-1023)",
