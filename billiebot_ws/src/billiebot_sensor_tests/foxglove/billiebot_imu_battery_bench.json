    "Indicator!bat02_mode": {
      "foxglovePanelTitle": "Mission mode",
      "path": "/billiebot/mission_status.mode",
      "style": "background",
      "fontSize": 24,
      "rules": [
        {
          "operator": "=",
          "rawValue": "5",
          "color": "#d62728",
          "label": "SAFE (5)"
        },
        {
          "operator": "=",
          "rawValue": "4",
          "color": "#9467bd",
          "label": "RETURN (4)"
        },
        {
          "operator": "=",
          "rawValue": "3",
          "color": "#17becf",
          "label": "TRACK_OBSERVE (3)"
        },
        {
          "operator": "=",
          "rawValue": "2",
          "color": "#ff7f0e",
          "label": "INVESTIGATE (2)"
        },
        {
          "operator": "=",
          "rawValue": "1",
          "color": "#2ca02c",
          "label": "PATROL (1)"
        },
        {
          "operator": "=",
          "rawValue": "0",
