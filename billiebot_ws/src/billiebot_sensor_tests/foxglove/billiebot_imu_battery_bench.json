      "minLevel": 0,
      "sortByLevel": true,
      "secondsUntilStale": 5,
      "hardwareIdFilter": "",
      "pinnedIds": []
    },
    "RosOut!bench_log": {
      "foxglovePanelTitle": "Log (/rosout) - INFO and above",
      "topicToRender": "/rosout",
      "minLogLevel": 2,
      "searchTerms": [],
      "showLevel": true,
      "showTime": true,
      "showName": true,
      "showDate": false,
      "showTimezone": false,
      "showSourceLocation": false
    },

    "Tab!main": {
      "activeTabIdx": 0,
      "tabs": [
        {
          "title": "IMU Acquisition",
